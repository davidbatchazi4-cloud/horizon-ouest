<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS du site Horizon Ouest.
  - IIS sert lui-meme les fichiers du site (pages, css, js, images).
  - Tout ce qui commence par /api (ainsi que /docs et /openapi.json) est transmis au serveur
    Python FastAPI qui tourne a cote, sur 127.0.0.1:8001 : c'est le « proxy inverse »
    (modules URL Rewrite + Application Request Routing).
  - Le dossier backend (code Python, messages, mot de passe administrateur) n'est JAMAIS servi.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="API vers FastAPI" stopProcessing="true">
          <match url="^(api/.*|docs.*|openapi\.json)$" />
          <action type="Rewrite" url="http://127.0.0.1:8001/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Dossiers interdits : aucune URL ne peut y entrer -->
        <hiddenSegments>
          <add segment="backend" />
          <add segment=".git" />
          <add segment="__pycache__" />
          <add segment=".pytest_cache" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".jsonl" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
